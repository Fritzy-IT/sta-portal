{
  "functions": {
    "index.php": {
      "runtime": "vercel-php@0.7.5"
    },
    "download_handler.php": {
      "runtime": "vercel-php@0.7.5"
    }
  },
  "routes": [
    { "src": "/", "dest": "index.php" },
    { "src": "/download/(.*)", "dest": "download_handler.php?file=$1" }
  ]
}
